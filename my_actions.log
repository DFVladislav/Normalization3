2026-11-18T06:29:30.345304Z	   18 Query	USE staff_norm
2026-11-18T06:29:30.345548Z	   18 Query	CREATE TABLE departments (
    department_id   INT          NOT NULL,
    department_name VARCHAR(100) NOT NULL,
    PRIMARY KEY (department_id)
)
2026-11-18T06:29:30.377583Z	   18 Query	CREATE TABLE employees (
    employee_id   INT          NOT NULL,
    employee_name VARCHAR(100) NOT NULL,
    department_id INT          NOT NULL,
    PRIMARY KEY (employee_id),
    FOREIGN KEY (department_id) REFERENCES departments (department_id)
)
2026-11-18T06:29:30.420998Z	   18 Query	CREATE TABLE employee_sales (
    employee_id INT           NOT NULL,
    sales_month DATE          NOT NULL,
    sales       DECIMAL(12,2) NOT NULL,
    PRIMARY KEY (employee_id, sales_month),
    FOREIGN KEY (employee_id) REFERENCES employees (employee_id)
)
